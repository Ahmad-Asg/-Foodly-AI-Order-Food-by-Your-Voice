# Copy this file to .env and replace the value with your own MongoDB Atlas URI.
# Never share or commit the real URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/foodly_ai?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-5-mini
